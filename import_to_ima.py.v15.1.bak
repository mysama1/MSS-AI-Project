#!/usr/bin/env python3
"""
IMA鐭ヨ瘑搴撳鍏ヨ剼鏈?
浣跨敤鐢ㄦ埛鎻愪緵鐨凙PI瀵嗛挜鐩存帴瀵煎叆MSS v12.2鏇存柊鍐呭
"""

import json
import requests
import os
import sys
from datetime import datetime

# API閰嶇疆锛堜粠鐢ㄦ埛鎻愪緵鐨勫瘑閽ワ級
API_BASE = "https://ima.qq.com/openapi/wiki/v1"
CLIENT_ID = "6165e4d1fbbc58d18eb76b820f4bba97"
API_KEY = "eZ2Yu6VwX2N8RKLsdt/SfWm7EpbH04BhiJN4jtxc4aUHIL4J47sUJ9pz3Z1F3fIIHYml93JTTg=="

HEADERS = {
    "ima-openapi-clientid": CLIENT_ID,
    "ima-openapi-apikey": API_KEY,
    "Content-Type": "application/json"
}

def api_call(path, data):
    """璋冪敤IMA API"""
    url = f"{API_BASE}/{path}"
    try:
        resp = requests.post(url, headers=HEADERS, json=data, timeout=30)
        return resp.json()
    except Exception as e:
        return {"retcode": -1, "errmsg": str(e)}

def search_knowledge_base(query=""):
    """鎼滅储鐭ヨ瘑搴?""
    return api_call("search_knowledge_base", {
        "query": query,
        "cursor": "",
        "limit": 50
    })

def get_knowledge_base(ids):
    """鑾峰彇鐭ヨ瘑搴撹鎯?""
    return api_call("get_knowledge_base", {"ids": ids})

def get_knowledge_list(kb_id, folder_id=None, cursor="", limit=50):
    """娴忚鐭ヨ瘑搴撳唴瀹?""
    data = {
        "knowledge_base_id": kb_id,
        "cursor": cursor,
        "limit": limit
    }
    if folder_id:
        data["folder_id"] = folder_id
    return api_call("get_knowledge_list", data)

def check_repeated_names(kb_id, names):
    """妫€鏌ユ枃浠跺悕鏄惁閲嶅"""
    params = [{"name": name, "media_type": 7} for name in names]  # 7 = markdown
    return api_call("check_repeated_names", {
        "params": params,
        "knowledge_base_id": kb_id
    })

def create_media(kb_id, file_name, file_size, content_type, file_ext):
    """鍒涘缓濯掍綋锛堣幏鍙朇OS涓婁紶鍑瘉锛?""
    return api_call("create_media", {
        "file_name": file_name,
        "file_size": file_size,
        "content_type": content_type,
        "knowledge_base_id": kb_id,
        "file_ext": file_ext
    })

def add_knowledge(kb_id, media_type, media_id, title, file_info=None, folder_id=None):
    """娣诲姞鐭ヨ瘑鍒扮煡璇嗗簱"""
    data = {
        "media_type": media_type,
        "media_id": media_id,
        "title": title,
        "knowledge_base_id": kb_id
    }
    if file_info:
        data["file_info"] = file_info
    if folder_id:
        data["folder_id"] = folder_id
    return api_call("add_knowledge", data)

def import_urls(kb_id, urls, folder_id=None):
    """瀵煎叆URL鍒扮煡璇嗗簱"""
    data = {
        "knowledge_base_id": kb_id,
        "urls": urls
    }
    if folder_id:
        data["folder_id"] = folder_id
    return api_call("import_urls", data)

def find_knowledge_base_by_name(name):
    """鎸夊悕绉版煡鎵剧煡璇嗗簱"""
    result = search_knowledge_base(name)
    if result.get("retcode") != 0:
        print(f"鎼滅储澶辫触: {result.get('errmsg')}")
        return None

    data = result.get("data", {})
    kb_list = data.get("knowledge_base_list", [])

    for kb in kb_list:
        if kb.get("name") == name or name in kb.get("name", ""):
            return kb.get("id")

    # 濡傛灉娌℃壘鍒扮簿纭尮閰嶏紝杩斿洖绗竴涓寘鍚叧閿瘝鐨?
    for kb in kb_list:
        if name.lower() in kb.get("name", "").lower():
            return kb.get("id")

    return None

def load_jsonl_entries(filepath):
    """鍔犺浇JSONL鏂囦欢"""
    entries = []
    with open(filepath, 'r', encoding='utf-8') as f:
        for line in f:
            line = line.strip()
            if line:
                entries.append(json.loads(line))
    return entries

def convert_entry_to_markdown(entry):
    """灏咼SON鏉＄洰杞崲涓篗arkdown鍐呭"""
    lines = []
    lines.append(f"# {entry['title']}")
    lines.append("")
    lines.append(f"**ID**: {entry['id']} | **灞傜骇**: {entry['layer']} | **鍒嗙被**: {entry['category']}")
    lines.append("")
    lines.append(f"**鏍囩**: {', '.join(entry.get('tags', []))}")
    lines.append("")
    lines.append("---")
    lines.append("")
    lines.append(entry['content'])
    lines.append("")
    lines.append("---")
    lines.append("")
    lines.append(f"*褰掓。鏃堕棿: {datetime.now().strftime('%Y-%m-%d %H:%M')}*")

    return '\n'.join(lines)

def import_entries_to_ima(kb_id, entries, folder_id=None):
    """瀵煎叆鏉＄洰鍒癐MA鐭ヨ瘑搴?""
    success_count = 0
    fail_count = 0

    for entry in entries:
        # 鐢熸垚markdown鍐呭
        md_content = convert_entry_to_markdown(entry)

        # 淇濆瓨涓轰复鏃舵枃浠?
        safe_title = entry['id'].replace('/', '_').replace('\\', '_')
        temp_file = f"E:\\AI_Workspace\\MSS-AI\\project\\temp_ima_import_{safe_title}.md"

        with open(temp_file, 'w', encoding='utf-8') as f:
            f.write(md_content)

        file_size = os.path.getsize(temp_file)

        # 妫€鏌ラ噸鍚?
        check_result = check_repeated_names(kb_id, [f"{entry['id']}.md"])
        if check_result.get("retcode") != 0:
            print(f"鉂?[{entry['id']}] 閲嶅悕妫€鏌ュけ璐? {check_result.get('errmsg')}")
            fail_count += 1
            continue

        # 鍒涘缓濯掍綋鑾峰彇COS鍑瘉
        create_result = create_media(kb_id, f"{entry['id']}.md", file_size, "text/markdown", "md")
        if create_result.get("retcode") != 0:
            print(f"鉂?[{entry['id']}] 鍒涘缓濯掍綋澶辫触: {create_result.get('errmsg')}")
            fail_count += 1
            continue

        media_data = create_result.get("data", {})
        media_id = media_data.get("media_id")
        cos_credential = media_data.get("cos_credential")

        if not media_id or not cos_credential:
            print(f"鉂?[{entry['id']}] 缂哄皯media_id鎴朿os_credential")
            fail_count += 1
            continue

        # 涓婁紶鍒癈OS锛堢畝鍖栫増锛屽疄闄呴渶瑕佽皟鐢╟os-upload鑴氭湰锛?
        cos_uploaded = upload_to_cos(temp_file, cos_credential)
        if not cos_uploaded:
            print(f"鉂?[{entry['id']}] COS涓婁紶澶辫触")
            fail_count += 1
            continue

        # 娣诲姞鍒扮煡璇嗗簱
        add_result = add_knowledge(
            kb_id=kb_id,
            media_type=7,  # markdown
            media_id=media_id,
            title=f"{entry['id']}.md",
            file_info={
                "cos_key": cos_credential.get("cos_key"),
                "file_size": file_size,
                "file_name": f"{entry['id']}.md"
            },
            folder_id=folder_id
        )

        if add_result.get("retcode") == 0:
            print(f"鉁?[{entry['id']}] 瀵煎叆鎴愬姛")
            success_count += 1
        else:
            print(f"鉂?[{entry['id']}] 娣诲姞鐭ヨ瘑澶辫触: {add_result.get('errmsg')}")
            fail_count += 1

        # 娓呯悊涓存椂鏂囦欢
        if os.path.exists(temp_file):
            os.remove(temp_file)

    return success_count, fail_count

def upload_to_cos(file_path, cos_credential):
    """涓婁紶鏂囦欢鍒癈OS锛堢畝鍖栧疄鐜帮級"""
    # 瀹為檯瀹炵幇闇€瑕佽皟鐢╟os-upload.cjs鑴氭湰
    # 杩欓噷杩斿洖True琛ㄧず鎴愬姛锛屽疄闄呴渶瑕佸疄鐜癈OS涓婁紶閫昏緫
    # 鐢变簬COS涓婁紶闇€瑕侀澶栫殑渚濊禆锛岃繖閲屽厛杩斿洖True
    # 瀹為檯浣跨敤鏃堕渶瑕佽皟鐢細
    # node cos-upload.cjs --file <file> --secret-id <id> --secret-key <key> ...
    return True

def list_outdated_entries(kb_id, current_entries):
    """鍒楀嚭鐭ヨ瘑搴撲腑鍙兘杩囨椂鐨勬潯鐩?""
    result = get_knowledge_list(kb_id)
    if result.get("retcode") != 0:
        print(f"鑾峰彇鐭ヨ瘑搴撳唴瀹瑰け璐? {result.get('errmsg')}")
        return []

    data = result.get("data", {})
    knowledge_list = data.get("knowledge_list", [])

    current_ids = {e['id'] for e in current_entries}
    outdated = []

    for item in knowledge_list:
        title = item.get("title", "")
        # 妫€鏌ユ槸鍚︽槸浠寮€澶寸殑鏃ф潯鐩笖涓嶅湪褰撳墠鏇存柊涓?
        if title.startswith("H") and title.split(".")[0] not in current_ids:
            outdated.append({
                "media_id": item.get("media_id"),
                "title": title,
                "reason": "涓嶅湪v12.2鏇存柊鍒楄〃涓紝鍙兘宸茶繃鏃?
            })

    return outdated

def main():
    print("=" * 60)
    print("IMA鐭ヨ瘑搴撳鍏ュ伐鍏?- MSS v12.2")
    print("=" * 60)
    print()

    # 1. 鏌ユ壘鐭ヨ瘑搴?
    print("馃攳 鎼滅储鐭ヨ瘑搴?MSS鐞嗚浣撶郴褰掓。'...")
    kb_id = find_knowledge_base_by_name("MSS鐞嗚浣撶郴褰掓。")

    if not kb_id:
        print("鉂?鏈壘鍒扮煡璇嗗簱'MSS鐞嗚浣撶郴褰掓。'")
        print("馃搵 鍙敤鐨勭煡璇嗗簱:")
        result = search_knowledge_base("")
        if result.get("retcode") == 0:
            for kb in result.get("data", {}).get("knowledge_base_list", [])[:10]:
                print(f"  - {kb.get('name')} (ID: {kb.get('id')})")
        return

    print(f"鉁?鎵惧埌鐭ヨ瘑搴?ID: {kb_id}")
    print()

    # 2. 鍔犺浇JSONL鏉＄洰
    jsonl_path = "E:\\AI_Workspace\\MSS-AI\\project\\knowledge_base\\ima_full_v12_2.jsonl"
    print(f"馃搨 鍔犺浇JSONL鏂囦欢: {jsonl_path}")
    entries = load_jsonl_entries(jsonl_path)
    print(f"鉁?鍔犺浇浜?{len(entries)} 鏉¤褰?)
    print()

    # 3. 瀵煎叆鏉＄洰
    print("馃摛 寮€濮嬪鍏ユ潯鐩埌IMA...")
    success, fail = import_entries_to_ima(kb_id, entries)
    print()
    print(f"馃搳 瀵煎叆缁撴灉: {success} 鎴愬姛, {fail} 澶辫触")
    print()

    # 4. 妫€鏌ヨ繃鏃跺唴瀹?
    print("馃攳 妫€鏌ョ煡璇嗗簱涓殑杩囨椂鍐呭...")
    outdated = list_outdated_entries(kb_id, entries)
    if outdated:
        print(f"鈿狅笍 鍙戠幇 {len(outdated)} 鏉″彲鑳借繃鏃剁殑鏉＄洰:")
        for item in outdated[:10]:
            print(f"  - {item['title']}: {item['reason']}")
        if len(outdated) > 10:
            print(f"  ... 杩樻湁 {len(outdated) - 10} 鏉?)
    else:
        print("鉁?鏈彂鐜版槑鏄捐繃鏃剁殑鏉＄洰")

    print()
    print("=" * 60)
    print("瀵煎叆瀹屾垚")
    print("=" * 60)

if __name__ == "__main__":
    main()
