浠庛€岀浜恒€佺浜嬨€佺娴佺▼銆嶅交搴曡穬杩佷负銆岃皟鍦恒€佹姢鑷棆銆佺瓑鐩稿彉銆嶃€?
"""

def analyze_section(title, content, claimed_layer="L3"):
    """鍒嗘瀽鍗曚釜绔犺妭"""
    print(f"\n{'='*60}")
    print(f"鍒嗘瀽: {title}")
    print(f"{'='*60}")

    result = analyze_text(content, claimed_layer=claimed_layer)

    print(f"鎬诲垎: {result['overall_score']}")
    print(f"娓呮磥搴? {result['scores']['cleanliness']}")
    print(f"灞傜骇涓€鑷存€? {result['scores']['layer_consistency']}")
    print(f"RSCA鍚堣: {result['scores']['rsca_compliance']}")
    print(f"杩囧害瀹ｇО鎸囨暟: {result['scores']['overclaim_index']}")
    print(f"妫€娴嬪埌灞傜骇: {result['layer']['detected']}")
    print(f"澹扮О灞傜骇: {result['layer']['claimed']}")

    if result['issues']:
        print(f"\n鍙戠幇闂 ({len(result['issues'])}涓?:")
        for i, issue in enumerate(result['issues'][:10], 1):  # 鍙樉绀哄墠10涓?
            print(f"  {i}. [{issue['severity']}] {issue['category']}: {issue['message']}")
            if issue.get('suggestion'):
                print(f"     寤鸿: {issue['suggestion']}")

    if result['suggestions']:
        print(f"\n鏀硅繘寤鸿:")
        for s in result['suggestions']:
            print(f"  - {s}")

    return result

# 鍒嗘瀽鎵€鏈夌珷鑺?
results = []
results.append(analyze_section("鏃嬭€楁暎-鑷棆缁熶竴鍦?, content_part1, "L3"))
results.append(analyze_section("K4杩戜技姘稿姩鏂囨槑", content_part2, "L3"))
results.append(analyze_section("缁勭粐瑙勮寖鍦?涓綋鑷棆鑰﹀悎", content_part3, "L3"))
results.append(analyze_section("宸ヤ綔娴佸鐩告€佽皟鍒?, content_part4, "L3"))
results.append(analyze_section("K3绠＄悊瀛﹀崌缁撮噸鏋?, content_part5, "L3"))

# 姹囨€?
print(f"\n{'='*60}")
print("姹囨€绘姤鍛?)
print(f"{'='*60}")

avg_score = sum(r['overall_score'] for r in results) / len(results)
print(f"骞冲潎鎬诲垎: {avg_score:.3f}")

for i, r in enumerate(results, 1):
    status = "閫氳繃" if r['overall_score'] >= 0.7 else "闇€淇敼" if r['overall_score'] >= 0.4 else "鎷掔粷"
    print(f"  绔犺妭{i}: {r['overall_score']:.3f} - {status}")

# 缁熻闂
all_issues = []
for r in results:
    all_issues.extend(r['issues'])

fatal_count = sum(1 for i in all_issues if i['severity'] == 'FATAL')
major_count = sum(1 for i in all_issues if i['severity'] == 'MAJOR')
minor_count = sum(1 for i in all_issues if i['severity'] == 'MINOR')

print(f"\n闂缁熻:")
print(f"  FATAL: {fatal_count}")
print(f"  MAJOR: {major_count}")
print(f"  MINOR: {minor_count}")
print(f"  鎬昏: {len(all_issues)}")

# 淇濆瓨缁撴灉
with open('ai_content_analysis.json', 'w', encoding='utf-8') as f:
    json.dump({
        'sections': results,
        'summary': {
            'avg_score': avg_score,
            'total_issues': len(all_issues),
            'fatal_count': fatal_count,
            'major_count': major_count,
            'minor_count': minor_count
        }
    }, f, ensure_ascii=False, indent=2)

print(f"\n璇︾粏缁撴灉宸蹭繚瀛樿嚦 ai_content_analysis.json")
