    # ============================================================
    # 鎸佷箙鍖?
    # ============================================================
    def _save_virus(self, report: VirusReport):
        import os
        fp = os.path.join(self.workspace, "viruses", f"{report.virus_id[:16]}.json")
        with open(fp, 'w', encoding='utf-8') as f:
            json.dump({"virus_id": report.virus_id, "virus_type": report.virus_type.value,
                       "translation_fidelity": report.translation_fidelity,
                       "heat_tax": report.heat_tax, "timestamp": report.timestamp}, f, ensure_ascii=False, indent=2)
    
    def _save_dissection(self, report: DissectionReport):
        import os
        fp = os.path.join(self.workspace, "dissections", f"{report.virus_id[:16]}.json")
        with open(fp, 'w', encoding='utf-8') as f:
            json.dump({"virus_id": report.virus_id, "target_axiom": report.target_axiom,
                       "vulnerability_score": report.vulnerability_score,
                       "rscca_passed": report.rscca_passed,
                       "heat_tax": report.heat_tax, "timestamp": report.timestamp}, f, ensure_ascii=False, indent=2)
    
    def _save_patch(self, patch_id: str, content: Dict, dissection: DissectionReport):
        import os
        fp = os.path.join(self.workspace, "sandbox", f"{patch_id}.json")
        with open(fp, 'w', encoding='utf-8') as f:
            json.dump({"patch_id": patch_id, "content": content,
                       "target_axiom": dissection.target_axiom}, f, ensure_ascii=False, indent=2)
    
    def _load_patch(self, patch_id: str) -> Optional[Dict]:
        import os
        fp = os.path.join(self.workspace, "sandbox", f"{patch_id}.json")
        if not os.path.exists(fp):
            return None
        with open(fp, 'r', encoding='utf-8') as f:
            return json.load(f).get("content")
    
    def _save_vaccine(self, vaccine: Vaccine):
        import os
        fp = os.path.join(self.workspace, "vaccines", f"{vaccine.vaccine_id}.json")
        with open(fp, 'w', encoding='utf-8') as f:
            json.dump({"vaccine_id": vaccine.vaccine_id, "virus_id": vaccine.virus_id,
                       "target_axiom": vaccine.target_axiom,
                       "efficacy_score": vaccine.efficacy_score,
                       "status": vaccine.status.value,
                       "deployed_at": vaccine.deployed_at}, f, ensure_ascii=False, indent=2)
    
    def _save_protection_belt(self):
        import os
        fp = os.path.join(self.workspace, "belt", "protection_belt.json")
        with open(fp, 'w', encoding='utf-8') as f:
            json.dump(self.protection_belt, f, ensure_ascii=False, indent=2)
    
    def _record_heat_tax(self, stage: str, virus_id: str, gamma: float, note: str):
        self.heat_tax_ledger.append({
            "stage": stage, "virus_id": virus_id[:16],
            "gamma": gamma, "note": note,
            "timestamp": datetime.now().isoformat(),
        })
        # 淇濆瓨鍒扮儹绋庤处鏈?
        import os
        fp = os.path.join(self.workspace, "heat_tax_ledger.jsonl")
        with open(fp, 'a', encoding='utf-8') as f:
            f.write(json.dumps(self.heat_tax_ledger[-1], ensure_ascii=False) + "\n")
    
    def _load_state(self):
        import os, glob
        # 鍔犺浇鐥呮瘨
        for fp in glob.glob(os.path.join(self.workspace, "viruses", "*.json")):
            with open(fp, 'r', encoding='utf-8') as f:
                d = json.load(f)
                # 绠€鍖栧姞杞斤紝瀹為檯搴斿畬鏁撮噸寤篤irusReport瀵硅薄
# K4 Logical Vaccine Engine v1.0
        for fp in glob.glob(os.path.join(self.workspace, "vaccines", "*.json")):
            with open(fp, 'r', encoding='utf-8') as f:
                d = json.load(f)
        # 鍔犺浇淇濇姢甯?
        belt_fp = os.path.join(self.workspace, "belt", "protection_belt.json")
        if os.path.exists(belt_fp):
            with open(belt_fp, 'r', encoding='utf-8') as f:
                self.protection_belt = json.load(f)
    
