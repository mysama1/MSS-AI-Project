    def _hash(self, text: str) -> str:
        return hashlib.sha256(text.encode('utf-8')).hexdigest()
    
    def _hash_json(self, obj) -> str:
        return hashlib.sha256(json.dumps(obj, sort_keys=True).encode('utf-8')).hexdigest()
    
